{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "//": [
    "One profile for each deployment shape. Select one, then press F5.",
    "Run ./scripts/seed-dev-db.ps1 one time first: it writes build/dev/app.db, and the sidecar",
    "never creates a database.",
    "All profiles serve http://localhost:8080 with the token dev-token, thus mcp.http works",
    "against any of them with no change.",
    "There is no HTTPS profile. A reverse proxy terminates TLS and the sidecar has no HTTPS",
    "redirection.",
    "The database path is relative to the project directory, which is the working directory."
  ],
  "profiles": {
    "read-only (schema,read)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SQLITE_SIDECAR_DB": "../../build/dev/app.db",
        "SQLITE_SIDECAR_TOKEN": "dev-token",
        "SQLITE_SIDECAR_PERMISSIONS": "schema,read"
      }
    },
    "agent (schema,read,write,backup)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SQLITE_SIDECAR_DB": "../../build/dev/app.db",
        "SQLITE_SIDECAR_TOKEN": "dev-token",
        "SQLITE_SIDECAR_PERMISSIONS": "schema,read,write,backup",
        "SQLITE_SIDECAR_BACKUP_DIR": "../../build/dev/backups"
      }
    },
    "privileged (all permissions)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SQLITE_SIDECAR_DB": "../../build/dev/app.db",
        "SQLITE_SIDECAR_TOKEN": "dev-token",
        "SQLITE_SIDECAR_PERMISSIONS": "schema,read,write,backup,diagnostics,danger-raw-write",
        "SQLITE_SIDECAR_BACKUP_DIR": "../../build/dev/backups"
      }
    }
  }
}
